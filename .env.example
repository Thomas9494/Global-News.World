# ---- Server ----
PORT=8787
HOST=0.0.0.0

# ---- Ingest ----
# Minutes between full ingest cycles (0 disables the scheduler)
INGEST_INTERVAL_MIN=15
# Parallel feed fetches
INGEST_CONCURRENCY=12
# Per-feed timeout in ms
FEED_TIMEOUT_MS=15000
# Max articles kept per country
MAX_ARTICLES_PER_COUNTRY=200
# Drop articles older than this many hours (0 = keep all)
MAX_ARTICLE_AGE_H=72
# Countries that produced nothing inside that window get a longer one, so a
# quiet or thinly-indexed country still appears. The card always shows the real
# age, so nothing is passed off as fresh. 0 disables the second look.
QUIET_COUNTRY_AGE_H=336
# Route worldwide wire copy (Reuters, BBC World, allAfrica …) to the country
# each story is actually about
ROUTE_GLOBAL_FEEDS=true
# Run one ingest cycle immediately on boot
INGEST_ON_BOOT=true

# ---- News plugins ----
# Open, no API key. These carry the map.
PLUGIN_RSS=true
# Local outlets keyed by the town they publish in (data/city-sources.json).
# This is what makes a city-level zoom worth doing.
PLUGIN_CITY_PRESS=true
CITY_PRESS_PER_FEED=10
PLUGIN_OPML=true
PLUGIN_GOOGLE_NEWS=true

# Google News editions — how the map reaches every country and capital.
#   gaps = only countries with no curated outlet of their own (default)
#   all  = every country, even where curated outlets already deliver
GOOGLE_NEWS_SCOPE=gaps
# Also pull a place-scoped feed for each capital
GOOGLE_NEWS_CAPITALS=true
GOOGLE_NEWS_PER_FEED=12
GOOGLE_NEWS_CONCURRENCY=6
# Hard ceiling on requests per cycle
GOOGLE_NEWS_MAX_REQUESTS=420

# OPML import — point this at a subscription list to add feeds in bulk
OPML_FILE=data/feeds.opml
OPML_URL=

# ---- Optional plugins (off unless configured) ----
# GDELT DOC 2.0 — free, no key, worldwide. Blocked from some networks.
PLUGIN_GDELT=false
# NewsAPI.org
PLUGIN_NEWSAPI=false
NEWSAPI_KEY=
# GNews.io
PLUGIN_GNEWS=false
GNEWS_KEY=

# ---- Reader language ----
# How a visitor's language is worked out, strongest signal first:
#   ?lang=xx  →  CDN geo header  →  optional IP lookup  →  Accept-Language  →  TRANSLATE_TARGET
# Behind Cloudflare / Vercel / CloudFront the geo header arrives for free and
# no IP lookup is needed. Set this only if you have neither.
#   ipapi | ip-api   (leave blank to disable)
GEOIP_PROVIDER=

# ---- Translation ----
# none | libretranslate | deepl
# With `none` the panel says so and shows the original — it never pretends.
TRANSLATE_PROVIDER=none
# Fallback reading language when the visitor cannot be placed
TRANSLATE_TARGET=en
LIBRETRANSLATE_URL=https://libretranslate.com
LIBRETRANSLATE_KEY=
DEEPL_KEY=
DEEPL_URL=https://api-free.deepl.com
# Max translated characters per ingest cycle (cost guard)
TRANSLATE_BUDGET_CHARS=200000

# ---- Operations ----
# Enables POST /api/ingest with the x-ingest-token header. Unset = endpoint closed.
INGEST_TOKEN=
# Identify yourself honestly to the outlets you read
FEED_USER_AGENT=
